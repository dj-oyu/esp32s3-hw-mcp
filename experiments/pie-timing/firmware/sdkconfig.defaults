# Measurement firmware: keep the clock fixed and the scheduling noise low.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Nothing here needs Wi-Fi/BT; leaving them off keeps the image small and the timing quiet.
CONFIG_BT_ENABLED=n
